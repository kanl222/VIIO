# ==========================================
# Конфигурация VIIO (.env)
# ==========================================

# --- Общий провайдер агентов: lmstudio, ollama или yandex ---
LLM_PROVIDER=lmstudio
# Общий провайдер агентов: lmstudio, ollama или yandex.
# Для всех агентов через Yandex: LLM_PROVIDER=yandex и заполните YANDEX_* ниже.
# Провайдер локальных сервисов Documents/RAG/worker, независимо от облачных агентов.
LOCAL_LLM_PROVIDER=lmstudio

# --- Настройки LM Studio (локальный OpenAI-совместимый сервер на хосте) ---
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen/qwen3-4b-2507
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# --- Настройки Ollama (если LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Настройки векторного хранилища Qdrant ---
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=knowledge_base
QDRANT_PUBLIC_COLLECTION_NAME=knowledge_public
ASSISTENT_PORT=8000
DOCUMENTS_PORT=8002
# Для локальных процессов: Docker Compose настраивает внутренние адреса сервисов автоматически.
DOCUMENTS_URL=http://localhost:8002
DOCUMENT_WORKER_URL=http://localhost:8003
DOCUMENT_WORKER_CPUS=1
DOCUMENT_WORKER_MEMORY=2g
RAG_CHUNK_UNIT=characters
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_CONTEXT_MAX_CHARS=12000

# --- Настройки реляционной базы данных PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Порты сервисов ---
API_PORT=8000
WEBCHAT_PORT=3000

# --- Безопасность и межсервисная авторизация ---
INTERNAL_API_KEY=viio-internal-secret-token

# --- Инструменты единого агента ---
AGENT_MAX_TOOL_CALLS=24
# Инструмент save_knowledge использует DOCUMENTS_ADMIN_KEY и доступен только администраторам.
# Устаревшая настройка: отдельный coder больше не запускается.
CODING_AGENT_ENABLED=false
# Официальный удалённый GitHub MCP; токен с правами Contents: read.
# GITHUB_REPOSITORY=owner/repo ограничивает доступ одним репозиторием; * разрешает все доступные токену.
GITHUB_MCP_ENABLED=false
GITHUB_MCP_TOKEN=
GITHUB_REPOSITORY=
GITHUB_MCP_MAX_CHARS=16000
GITHUB_MCP_TIMEOUT_SECONDS=25
# Пустое значение: модель выбранного CODING_PROVIDER (для Yandex — YANDEX_MODEL).
CODING_MODEL=
# Разрешённые роли GitHub-инструмента (название сохранено для совместимости).
CODING_ALLOWED_ROLES=["programmer","admin"]
CODING_CONTEXT_MAX_CHARS=6000

# --- Параметры генерации: консультант и coder настраиваются отдельно ---
# Это стартовые значения; сравнивайте качество на своих вопросах.
CHAT_TEMPERATURE=0.0
CHAT_TOP_P=1.0
CHAT_MAX_TOKENS=2048
CODING_TEMPERATURE=0.0
CODING_TOP_P=1.0
CODING_MAX_TOKENS=4096

# --- Первый администратор (необязательно) ---
# Задайте ОБА значения до запуска. Пароль: от 12 символов, до 72 байт UTF-8.
# Если администратор уже есть, его пароль и права не изменяются.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Тестовая PostgreSQL через Postgres MCP Pro, только чтение ---
PGSQL_ENABLED=false
PGSQL_HOST=host.docker.internal
PGSQL_PORT=5432
PGSQL_DATABASE=
PGSQL_USER=
PGSQL_PASSWORD=
PGSQL_SSLMODE=prefer
PGSQL_MCP_URL=http://postgres-tool:8000/sse
PGSQL_MAX_ROWS=100
PGSQL_MAX_CHARS=12000
PGSQL_TIMEOUT_SECONDS=40

# PDF: auto = сначала текстовый слой, Docling CPU для сканов; docling = всегда Docling.
PDF_ENGINE=auto
PDF_MAX_BYTES=33554432
PDF_MAX_PAGES=200
PDF_MAX_CHARS=500000
PDF_TIMEOUT_SECONDS=1800
DOCLING_URL=http://pdf-worker:8080
DOCLING_CPU_THREADS=2

# Каталог и массовая загрузка (оригиналы в Docker-томе documents_storage)
DOCUMENTS_CATALOG_ENABLED=true
BULK_MAX_FILES=50
BULK_MAX_FILE_BYTES=10485760
BULK_MAX_WORKERS=1

# Саммари диалогов и независимый внешний API консультанта
CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_AFTER=24
CONVERSATION_HISTORY_MAX_CHARS=18000
CONSULTANT_ENABLED=false
# Сгенерируйте отдельный случайный ключ от 32 символов; никогда не используйте INTERNAL_API_KEY.
CONSULTANT_API_KEY=
CONSULTANT_SOURCE_KEY=
CONSULTANT_PORT=8001
CONSULTANT_PROVIDER=lmstudio
# Пустое значение использует модель проекта; при необходимости укажите отдельную модель.
CONSULTANT_MODEL=
CONSULTANT_TEMPERATURE=0.0
CONSULTANT_TOP_P=1.0
CONSULTANT_MAX_TOKENS=2048

# Генерация недостающих значений: python scripts/configure_runtime_secrets.py
# В production-сервисах общий ключ по умолчанию не используется.
CHAT_API_KEY=
DOCUMENTS_READ_KEY=
DOCUMENTS_ADMIN_KEY=
DOCUMENT_WORKER_KEY=
DOCLING_API_KEY=
QDRANT_API_KEY=
QDRANT_READ_KEY=
ASSISTENT_DB_PASSWORD=
DOCUMENTS_DB_PASSWORD=
WORKER_DB_PASSWORD=
WEBCHAT_DB_PASSWORD=
# Независимый процесс поиска (RAG). Documents сохраняет URL поиска для обратной совместимости.
RAG_URL=http://rag:8000
RAG_TIMEOUT_SECONDS=60
# Опциональный изолированный эндпоинт Yandex Cloud только для публичных текстов (по умолчанию выключен).
CONSULTANT_YANDEX_ENABLED=false
CONSULTANT_YANDEX_API_KEY=
CONSULTANT_YANDEX_FOLDER_ID=
CONSULTANT_YANDEX_MODEL=aliceai-llm
# Укажите CONSULTANT_PROVIDER=yandex для использования Yandex консультантом по базе знаний.
# Одобренные SHA-256 хэши точного вида title + перевод строки + content (JSON-массив).
CONSULTANT_CLOUD_PUBLIC_MATERIAL_HASHES=[]
# --- Модель единого агента ---
# Используются CHAT_PROVIDER / CHAT_MODEL; CODING_* и DATABASE_* ниже — совместимость.
# Перезапустите assistent после изменения. Не задавайте провайдерам пустую строку.
# CHAT_PROVIDER, CODING_PROVIDER и DATABASE_PROVIDER: lmstudio, ollama или yandex.
# Закомментированные провайдеры наследуют общий LLM_PROVIDER.
# CHAT_PROVIDER=lmstudio
CHAT_MODEL=
# CODING_PROVIDER=lmstudio
# CODING_MODEL задан выше в разделе агента программирования.
# DATABASE_PROVIDER=lmstudio
DATABASE_MODEL=

# --- Yandex AI Studio для единого агента ---
# Для облачного агента задайте LLM_PROVIDER=yandex или CHAT_PROVIDER=yandex.
# Заполните API-ключ и каталог. CHAT_PROVIDER и DATABASE_PROVIDER можно оставить локальными.
# Выбранный агент передаёт в облако сообщения и результаты инструментов: код, документы или данные БД.
# Эти настройки независимы от CONSULTANT_YANDEX_* и облачного RAG.
# Для Yandex по умолчанию у всех внутренних агентов задайте LLM_PROVIDER=yandex.
# LOCAL_LLM_PROVIDER остаётся lmstudio или ollama для поиска и индексации.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Короткое имя или полный URI gpt://<folder>/<model>; модель должна поддерживать инструменты агента.
YANDEX_MODEL=aliceai-llm
YANDEX_TIMEOUT_SECONDS=60
# Инструкция: docs/cloud-models.md

# Режимы RAG: local или yandex. Запросы могут явно выбирать любой режим.
ASSISTANT_RAG_BACKEND=local
CONSULTANT_RAG_BACKEND=local
# Существующий одобренный облачный индекс; должен совпадать с RAG/state/yandex-rag-runtime.json.
RAG_YANDEX_INDEX_ID=
RAG_YANDEX_MODEL=aliceai-llm
# В Compose RAG_YANDEX_API_KEY / RAG_YANDEX_FOLDER_ID по умолчанию берутся из CONSULTANT_YANDEX_*.
# Опциональные отдельные промпты; пустые значения используют умолчания из RAG/src/viio_rag/prompts.py.
RAG_YANDEX_ASSISTANT_PROMPT=
RAG_YANDEX_CONSULTANT_PROMPT=
