{
  "name": "agentai-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-highlighter.mjs",
    "prebuild": "npm run prepare:assets",
    "pretest": "npm run prepare:assets",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "server": "npm run build:server && node dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "npm run build:server && node --test test/server-auth.test.mjs test/chat-regressions.test.mjs test/bootstrap-admin.test.mjs test/catalog-routes.test.mjs test/session.test.mjs test/server.test.mjs test/highlighter.test.mjs"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.3"
  }
}
