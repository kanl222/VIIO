  "narrative": {
    "northStar": "Рабочее пространство VIIO",
    "overview": "The administration extension retains the incumbent indigo accent, neutral light and dark themes, sidebar navigation, and Lucide icons. Its direction is a functional workspace for finding users, managing access, and adding company knowledge. This is a record of the implemented system and the direction contract in `docs/admin-ui.md`, not a new brand identity.\n\nThe interface uses compact controls and tables, clear page headings, and generous separation between task groups. Color identifies selection, primary actions, and explicit service or submission states. No production raster assets were added; `.impeccable/screenshots/` contains fixture QA captures, not shipping assets.",
    "keyCharacteristics": [
      "Indigo actions and selected navigation.",
      "Neutral surfaces with shared light and dark semantic tokens.",
      "Compact operational controls with clearly separated task groups.",
      "Text, icons, and state color used together."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Reuse the semantic CSS variables from `WebChat/src/index.css` so surfaces, text, borders, and state colors change together.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** reuse semantic colors in both themes.",
      "**Do** preserve visible labels, keyboard focus, and text accompanying state colors.",
      "**Do** keep table overflow inside its container and collapse form grids at the implemented mobile breakpoint.",
      "**Do** treat the screenshots as fixture QA evidence, not production content or interface assets."
    ],
    "donts": [
      "**Don't** introduce a new brand palette or display font as part of the administration extension.",
      "**Don't** replace the implemented flat panel treatment with decorative card shadows.",
      "**Don't** present fixture counts as production measurements."
    ]
  }
}
